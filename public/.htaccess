Options -Indexes

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|svg|png|jpe?g|gif|ico|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <Files "feed.xml">
    Header set Cache-Control "public, max-age=3600"
  </Files>
</IfModule>

# Next.js Node hosting: do not rewrite unknown paths to index.html.
# That static-export fallback returns LiteSpeed 503 when index.html does not exist,
# while real public assets (e.g. /brand/*, /feed.xml) still return 200.
# HTML routes, robots.txt and sitemap.xml are handled by `next start`.
